# 환경 변수 템플릿
# 비워 두면 괄호 안의 기본값을 쓴다.

# 원본 데이터 폴더
# loader.py는 빈 값을 기본값으로 바꾸지 않으므로 실제 경로를 넣는다.
DATA_DIR=data/raw

# MLflow 기록 위치 (프로젝트 루트의 mlflow.db, 로컬 SQLite)
# docker compose의 app 컨테이너에서는 docker-compose.yml이 http://mlflow:5000으로 자동 지정하므로 비워 둬도 된다.
# 로컬 PC에서 실행하면서 Docker MLflow 서버에 기록하고 싶으면: http://localhost:5000
MLFLOW_TRACKING_URI=

# 최종 모델 학습 실험 이름 (credit-scoring)
MLFLOW_EXPERIMENT_NAME=

# 하이퍼파라미터 튜닝 실험 이름 (credit-scoring-tuning)
MLFLOW_TUNING_EXPERIMENT_NAME=

# Model Registry에 등록할 모델 이름 (credit-scoring-model)
MLFLOW_REGISTERED_MODEL=

# 부도 판정 기준 확률. 이 값 이상이면 부도로 판정 (0.5)
DECISION_THRESHOLD=
